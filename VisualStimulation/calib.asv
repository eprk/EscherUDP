

Screen('Preference', 'SkipSyncTests', 1);
screens = Screen('Screens');
sn = max(screens);
[w, sr] = Screen('OpenWindow',sn, 0);


val = (0:16:256)'-1;
mask = [0; 0; 1]; %blue
% mask = [1; 1; 1]; %gray
for i=1:numel(val)
    fprintf('Showing val %.3f\n',val(i))
    Screen('FillRect',w,[1; 1; 1].* mask.*val(i),sr);
    Screen('Flip',w);
    
    input('Press any key to go on','s');    
end
disp('the end')

Screen('CloseAll');


Screen('FillRect',w,[1; 1; 1].* mask.*0,sr);
    Screen('Flip',w);